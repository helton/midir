# Secrets and account-specific ids, referenced from config/midir.toml as ${NAME}. Copy to .env (repository root); never commit it.
STACKSPOT_REALM=                  # your StackSpot realm (referenced by config/midir.toml)
STACKSPOT_CLIENT_ID=
STACKSPOT_CLIENT_SECRET=
STACKSPOT_GPT_5_1_AGENT_ID=       # agents set up as in docs/backends/stackspot.md
STACKSPOT_GPT_4_1_AGENT_ID=
STACKSPOT_FLEX_AGENT_ID=          # StackSpot's own "Flex" agent of the account (optional)
# Time zone of the container's logs (IANA name; the container runs in UTC otherwise):
TZ=America/Sao_Paulo
# Any setting of midir.toml can be overridden by environment, e.g. at work:
# STACKSPOT_CA_BUNDLE=/etc/ssl/certs/corporate-ca.pem
# MIDIR_PORT=18880                # from source; in Docker the compose file sets the port
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:18884
# Another image or a registry mirror for docker/compose.yml goes in the shell or docker/.env (compose reads its own
# variables there, not here): MIDIR_IMAGE=<registry>/midir:<tag>
