     "expr": "sum by (client_name, midir_initiator) (rate(midir_requests_total{client_name=~\"$client\", gen_ai_response_model=~\"$model\", session_id=~\"$session\"}[$__rate_interval]) * 60)",
     "legendFormat": "{{client_name}} ({{midir_initiator}})",
     "refId": "A",
