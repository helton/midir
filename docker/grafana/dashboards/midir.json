  {
   "id": 7,
   "title": "Tokens per minute by agent",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (gen_ai_response_model, gen_ai_token_type) (rate(gen_ai_client_token_usage_total{client_name=~\"$client\", gen_ai_response_model=~\"$model\", session_id=~\"$session\"}[$__rate_interval]) * 60)",
     "legendFormat": "{{gen_ai_response_model}} {{gen_ai_token_type}}",
     "refId": "A",
     "format": "time_series",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 15,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "title": "LLM calls per minute by client",
   "type": "timeseries",
   "datasource": {
