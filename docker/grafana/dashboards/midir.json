  {
   "id": 4,
   "title": "Agent iterations per user turn",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(midir_requests_total{client_name=~\"$client\", gen_ai_response_model=~\"$model\", session_id=~\"$session\", midir_initiator=\"agent\"}[$__range])) / clamp_min(sum(increase(midir_requests_total{client_name=~\"$client\", gen_ai_response_model=~\"$model\", session_id=~\"$session\", midir_initiator=\"user\"}[$__range])), 1)",
     "legendFormat": "",
