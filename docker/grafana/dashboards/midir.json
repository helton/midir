  {
   "id": 9,
   "title": "Sessions (range): tokens, calls and iterations",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 24,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (session_id, client_name) (increase(gen_ai_client_token_usage_total{client_name=~\"$client\", gen_ai_response_model=~\"$model\", session_id=~\"$session\", gen_ai_token_type=\"input\"}[$__range]))",
     "legendFormat": "",
     "refId": "A",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (session_id, client_name) (increase(gen_ai_client_token_usage_total{client_name=~\"$client\", gen_ai_response_model=~\"$model\", session_id=~\"$session\", gen_ai_token_type=\"output\"}[$__range]))",
     "legendFormat": "",
     "refId": "B",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (session_id, client_name) (increase(midir_requests_total{client_name=~\"$client\", gen_ai_response_model=~\"$model\", session_id=~\"$session\"}[$__range]))",
     "legendFormat": "",
     "refId": "C",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (session_id, client_name) (increase(midir_requests_total{client_name=~\"$client\", gen_ai_response_model=~\"$model\", session_id=~\"$session\", midir_initiator=\"user\"}[$__range]))",
     "legendFormat": "",
     "refId": "D",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (session_id, client_name) (increase(midir_tool_calls_total{client_name=~\"$client\", gen_ai_response_model=~\"$model\", session_id=~\"$session\"}[$__range]))",
     "legendFormat": "",
     "refId": "E",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (session_id, client_name) (increase(midir_followups_total{client_name=~\"$client\", gen_ai_response_model=~\"$model\", session_id=~\"$session\"}[$__range]))",
     "legendFormat": "",
     "refId": "F",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (session_id, client_name) (rate(midir_request_duration_milliseconds_sum{client_name=~\"$client\", gen_ai_response_model=~\"$model\", session_id=~\"$session\"}[$__range]) / rate(midir_request_duration_milliseconds_count{client_name=~\"$client\", gen_ai_response_model=~\"$model\", session_id=~\"$session\"}[$__range]))",
     "legendFormat": "",
     "refId": "G",
     "format": "table",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "avg duration (ms)"
      },
      "properties": [
       {
        "id": "unit",
        "value": "ms"
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegex",
       "options": ".*tokens"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "gauge",
         "mode": "gradient"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "continuous-BlPu"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "footer": {
     "show": true,
     "reducer": [
      "sum"
     ],
     "fields": [
      "input tokens",
      "output tokens",
      "LLM calls"
     ]
    }
   },
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "session_id": "session",
       "client_name": "client",
       "Value #A": "input tokens",
       "Value #B": "output tokens",
       "Value #C": "LLM calls",
       "Value #D": "user turns",
       "Value #E": "tool calls",
       "Value #F": "follow-ups",
       "Value #G": "avg duration (ms)"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "input tokens",
        "desc": true
       }
      ]
     }
    }
   ]
  },
